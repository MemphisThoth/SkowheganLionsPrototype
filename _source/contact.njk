permalink: /contact/index.html
---

<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
</head>
<body>

{% include "partials/header.njk" %}

<main class="contact-page">

  <section class="contact-hero">
    <div class="container">
      <span class="section-eyebrow">Get in Touch</span>
      <h1>We'd love to hear from you.</h1>
      <p>Have a question about our club, interested in getting involved, or need assistance? Reach out to us.</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">

        <!-- Left column: Contact information -->
        <div class="contact-information">

          <div class="contact-intro">
            <span class="section-eyebrow">Contact Information</span>
            <h2>How can we help?</h2>
            <p>Our members are here to answer your questions and help connect you with the right person.</p>
          </div>

          <article class="contact-card">
            <div class="contact-card-icon">✉</div>
            <div>
              <h3>Cyndi French</h3>
              <span class="contact-role">Club President</span>
              <p>For general questions about the club and its activities.</p>
              <a href="mailto:cyndifrench53@gmail.com">cyndifrench53@gmail.com</a>
              <a href="tel:207.431.4659">207.431.4659</a>
            </div>
          </article>

          <article class="contact-card">
            <div class="contact-card-icon">✉</div>
            <div>
              <h3>Jared Perkins</h3>
              <span class="contact-role">Club Secretary & Webmaster</span>
              <p>For website questions, club correspondence, and general inquiries.</p>
              <a href="mailto:jaredperkins@hotmail.com">jared.perkins@hotmail.com</a>
              <a href="tel:2074312740">207.431.2740</a>
            </div>
          </article>

          <article class="contact-card">
            <div class="contact-card-icon">◎</div>
            <div>
              <h3>Bob Laney</h3>
              <span class="contact-role">Eyeglasses Chairperson</span>
              <p>For questions about our eyeglasses assistance program.</p>
              <a href="tel:2074745242">207.474.5242</a>
            </div>
          </article>

        </div>

        <!-- Right column: Contact form -->
        <div class="contact-form-wrapper">
          <div class="contact-form-heading">
            <span class="section-eyebrow">Send Us a Message</span>
            <h2>Contact the Lions</h2>
            <p>Fill out the form below and we'll get back to you as soon as possible.</p>
          </div>

          <form class="contact-form" action="#" method="POST">

            <div class="form-field">
              <label for="contact-name">Your Name</label>
              <input type="text" id="contact-name" name="name"
                     placeholder="Enter your name" required>
            </div>

            <div class="form-field">
              <label for="contact-email">Email Address</label>
              <input type="email" id="contact-email" name="email"
                     placeholder="you@example.com" required>
            </div>

            <div class="form-field">
              <label for="contact-subject">Subject</label>
              <select id="contact-subject" name="subject" required>
                <option value="" selected disabled>Select a subject</option>
                <option>General Information</option>
                <option>Membership</option>
                <option>Eyeglasses Assistance</option>
                <option>Community Service</option>
                <option>Website Question</option>
                <option>Other</option>
              </select>
            </div>

            <div class="form-field">
              <label for="contact-message">Your Message</label>
              <textarea id="contact-message" name="message" rows="6"
                        placeholder="How can we help?" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary contact-submit">
              Send Message <span aria-hidden="true">→</span>
            </button>

          </form>
        </div>

      </div>
    </div>
  </section>

</main>

{% include "partials/footer.njk" %}

</body>
</html>
