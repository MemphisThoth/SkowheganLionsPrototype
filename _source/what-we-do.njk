  <main>

    <!-- Hero -->
    <section class="service-hero">
      <div class="container">
        <span class="section-eyebrow">Neighbors Helping Neighbors</span>
        <h1>Making a Difference Through Service</h1>
        <p>
          From helping local families to supporting important causes,
          the Skowhegan Lions Club is committed to making our community
          and the world a better place.
        </p>
      </div>
    </section>

    <!-- Introduction -->
    <section class="service-intro">
      <div class="container">
        <div class="service-intro-content">
          <h2>Service Is at the Heart of What We Do</h2>
          <p>
            As Lions, we believe that even small acts of kindness can
            make a lasting difference. Our members work together to
            support local families, encourage young people, improve
            lives, and assist organizations that make a difference
            in our communities.
          </p>
          <p>
            Our service includes scholarships, charitable donations,
            vision and hearing assistance, food assistance, and
            seasonal programs that bring hope to families.
          </p>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="service-section">
      <div class="container">
        <div class="service-section-heading">
          <span class="section-eyebrow">Investing in Tomorrow</span>
          <h2>Education &amp; Youth</h2>
          <p>
            Supporting young people and helping them build a brighter future.
          </p>
        </div>

        <div class="service-card-grid">
          <article class="service-card">
            <div class="service-icon">🎓</div>
            <h3>Scholarships</h3>
            <p>
              We provide scholarship assistance to graduating high
              school seniors, helping students take their next steps
              toward higher education and future opportunities.
            </p>
          </article>

          <article class="service-card">
            <div class="service-icon">🌟</div>
            <h3>Boys State &amp; Girls State</h3>
            <p>
              We support opportunities for young people to develop
              leadership skills, learn about government, and become
              engaged citizens through Boys State and Girls State.
            </p>
          </article>

          <article class="service-card">
            <div class="service-icon">🖼️</div>
            <h3>Peace Poster Contest</h3>
            <p>
              Through the Lions International Peace Poster Contest,
              young artists are encouraged to express their ideas
              about peace, friendship, and understanding.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Health and Vision -->
    <section class="service-section service-section-alt">
      <div class="container">
        <div class="service-section-heading">
          <span class="section-eyebrow">Improving Lives</span>
          <h2>Health, Vision &amp; Hearing</h2>
          <p>
            Helping people access the resources and assistance they need.
          </p>
        </div>

        <div class="service-card-grid">
          <article class="service-card">
            <div class="service-icon">👓</div>
            <h3>Eyeglasses &amp; Hearing Aids</h3>
            <p>
              We assist with eyeglasses and hearing aid donations,
              helping people in need gain access to better vision
              and hearing resources.
            </p>
          </article>

          <article class="service-card">
            <div class="service-icon">❤️</div>
            <h3>Health Awareness</h3>
            <p>
              We support health-related causes, including diabetes
              awareness, breast cancer awareness, and the work of
              organizations dedicated to improving lives.
            </p>
          </article>

          <article class="service-card">
            <div class="service-icon">🐕</div>
            <h3>Guide Dog Support</h3>
            <p>
              We support the work of Fidelco Guide Dog Foundation,
              which helps people who are blind or visually impaired
              gain greater independence through guide dogs.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Charitable organizations -->
    <section class="service-section">
      <div class="container">
